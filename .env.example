# TEMPLATE ONLY. The app never reads this file.
#
# It is committed to git, so it must never contain a real value. Copy it to
# .env.local (gitignored) and put real values there:
#
#   cp .env.example .env.local
#
# Env vars are read at boot, so restart the dev server after changing .env.local.

# Cloud Postgres (Neon). Never commit the real value.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Pairing secret used to mint device tokens from the web app.
# openssl rand -base64 32
VIVY_PAIRING_SECRET=""

# Cloud model for the nightly brief and conversation (Tier 2 only).
ANTHROPIC_API_KEY=""

# Optional collectors
YOUTUBE_API_KEY=""
KITE_API_KEY=""
KITE_API_SECRET=""

# Web push. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Dev-only: fixes the signup code and skips sending email. Unset in production.
DEV_OTP_CODE="987306"

# Who may mint invite codes, comma-separated. Deliberately an env var rather
# than a database flag: a database compromise must not be able to grant admin.
# An empty value means nobody can sign up at all.
VIVY_ADMIN_EMAILS=""

# Protects the push cron endpoint. Vercel sends it automatically as a Bearer
# token on scheduled invocations; set the same value here.
# openssl rand -base64 32
CRON_SECRET=""

# Where the Android build lives, as "owner/repo". The settings page reads the
# newest GitHub release from here to serve the APK and answer update checks.
VIVY_GITHUB_REPO=""
