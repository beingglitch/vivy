# TEMPLATE ONLY. The app never reads this file.
#
# It is committed to git, so it must never contain a real value. Copy it to
# .env.local (gitignored) and put real values there:
#
#   cp .env.example .env.local
#
# Env vars are read at boot, so restart the dev server after changing .env.local.


# ---------------------------------------------------------------- required --

# Cloud Postgres (Neon). The only credential the app uses.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Who may mint invite codes, comma-separated. Deliberately an env var rather
# than a database flag: a database compromise must not be able to grant admin.
# An empty value means nobody can sign up at all.
VIVY_ADMIN_EMAILS=""


# ------------------------------------------------------------ notifications --

# Web push. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The NEXT_PUBLIC_ copy is the same value, exposed to the browser.
VAPID_PUBLIC_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Browser key for the in-app task location picker. Enable Maps JavaScript API
# and Geocoding API, then restrict this key to the app's HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Protects the push cron endpoint. Set this in production and Vercel sends it
# automatically as a Bearer token on scheduled runs. Leave it unset locally and
# the route stays open so you can call it by hand.
#   openssl rand -base64 32
CRON_SECRET=""


# ---------------------------------------------------------- android builds --

# Where the Android APK lives, as "owner/repo". Settings reads the newest
# release from here to offer the download and answer update checks.
VIVY_GITHUB_REPO=""

# Fine-grained token with Contents: read on that repo. Required when the repo
# is private: a private release asset's public link returns 404 to the phone,
# so the server exchanges it for a short-lived signed link instead.
GITHUB_TOKEN=""


# ----------------------------------------------------------------- dev only --

# Fixes the sign-in code to this value and skips sending email. There is no
# mail provider wired up yet, so without this nobody receives a code at all.
#
# UNSET THIS IN PRODUCTION. Leaving it set makes one fixed code valid for every
# account, and this file is public.
DEV_OTP_CODE="987306"
